# .env.local 로 복사해서 사용합니다 (.env*.local 은 git에 올라가지 않습니다).

# 백엔드 API 주소. USB로 연결한 폰에서는 `adb reverse tcp:8080 tcp:8080` 후 localhost를 그대로 씁니다.
# 공식 에뮬레이터라면 http://10.0.2.2:8080/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api

# true면 백엔드 없이 앱 안의 목업 데이터로 동작합니다 (src/api/mock).
EXPO_PUBLIC_API_MOCK=true
